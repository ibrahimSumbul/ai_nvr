{
  "uid": "ainvr-overview",
  "title": "AI NVR — Genel Bakış",
  "tags": [
    "ainvr"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "İlk Giriş (24s)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ainvr-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"deger\" FROM zone_events WHERE event_type='first_entry' AND ts > now() - interval '24 hours'"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Kamyon Olayı (toplam)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ainvr-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"deger\" FROM truck_events"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "LLM Başarı Oranı (%)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ainvr-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE success) / NULLIF(count(*), 0), 1) AS \"deger\" FROM llm_usage"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Dahua Alarm — Bekleyen",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ainvr-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"deger\" FROM zone_events WHERE event_type='first_entry' AND dahua_alarm_sent=false AND (metadata->>'alarm_emitted')::bool=true"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Alan Başına İlk Giriş (saatlik)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ainvr-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(ts, '1h') AS time, zone AS metric, count(*) AS value FROM zone_events WHERE event_type='first_entry' AND $__timeFilter(ts) GROUP BY 1, zone ORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Kamyon Çekici Rengi Dağılımı",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ainvr-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "right"
        },
        "pieType": "donut"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT coalesce(cekici_rengi, 'bilinmeyen') AS metric, count(*) AS value FROM truck_events GROUP BY 1 ORDER BY 2 DESC"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM Gecikme (ms, ortalama saatlik)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ainvr-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(ts, '1h') AS time, avg(latency_ms) AS \"ortalama_gecikme_ms\" FROM llm_usage WHERE success AND $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Son Zone Olayları",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ainvr-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT ts AS \"Zaman\", zone AS \"Alan\", event_type AS \"Tip\", round(score::numeric, 2) AS \"Skor\", coalesce((metadata->>'alarm_emitted')::bool, false) AS \"Alarm\" FROM zone_events ORDER BY ts DESC LIMIT 20"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Çevrimdışı Kamera",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "ainvr-postgres" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 21 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"deger\" FROM camera_status WHERE is_online = false"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Kamera Durumu",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "ainvr-postgres" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 21 },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT camera_id AS \"Kamera\", is_online AS \"Online\", last_seen_at AS \"Son Görülme\", offline_alert_sent AS \"Uyarildi\" FROM camera_status ORDER BY is_online ASC, camera_id"
        }
      ]
    }
  ]
}
