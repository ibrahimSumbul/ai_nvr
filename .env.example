# === Anthropic ===
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# === Postgres ===
POSTGRES_USER=ainvr
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ainvr
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# === Mosquitto MQTT ===
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USER=ainvr
MQTT_PASSWORD=change-me-strong-password

# === Dahua NVR (sadece alarm push için, RTSP değil) ===
DAHUA_NVR_HOST=192.168.10.10
DAHUA_NVR_USER=admin
DAHUA_NVR_PASSWORD=change-me

# === LLM Bütçe (PoC: 10, Production: 25) ===
LLM_MONTHLY_BUDGET_USD=10

# === SMTP (M6.5 sonrası kullanılır) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ainvr@example.com
SMTP_PASSWORD=change-me-gmail-app-password
SMTP_FROM=AI NVR <ainvr@example.com>
SMTP_TO_DEFAULT=guvenlik@example.com

# === Viewer (M6.5 sonrası kullanılır) ===
PORTAL_URL=https://ainvr.example.com
VIEW_TOKEN_SECRET=change-me-32-char-random-string-please
VIEW_TOKEN_TTL_DAYS=7

# === Frigate RTSP password (kameralar için) ===
FRIGATE_RTSP_PASSWORD=change-me

# === Grafana ===
GRAFANA_ADMIN_PASSWORD=change-me-admin

# === Log seviyesi ===
LOG_LEVEL=INFO
