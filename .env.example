# === LLM (M3+) ===
# Provider: 'ollama' (default, lokal) | 'anthropic' (gelecek, hibrit)
LLM_PROVIDER=ollama
# Ollama URL — mac host'tan native ollama servisine (Colima host.docker.internal)
LLM_OLLAMA_URL=http://host.docker.internal:11434
# Vision-capable model adı — `ollama list` çıktısından
LLM_OLLAMA_MODEL=qwen2.5vl:7b
# Timeout (saniye) ve retry (max sayı). CPU inference yavaş → 90s marj.
LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=2
# Truck detection score eşiği — Frigate bu altındaysa LLM çağrılmaz
LLM_TRUCK_MIN_SCORE=0.6
# LLM'e gönderilen snapshot max yüksekliği (px) — Frigate server-side resize
LLM_SNAPSHOT_MAX_HEIGHT=480

# === Anthropic (M3+'da hibrit fallback için, henüz aktif değil) ===
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# === Postgres ===
POSTGRES_USER=ainvr
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ainvr
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# === Mosquitto MQTT ===
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USER=ainvr
MQTT_PASSWORD=change-me-strong-password

# === Dahua NVR (M4 — external alarm push, RTSP değil) ===
DAHUA_NVR_HOST=192.168.10.10
DAHUA_NVR_PORT=80
DAHUA_NVR_USER=admin
DAHUA_NVR_PASSWORD=change-me
# Alarm push ana switch. Dev'de false (gerçek NVR yok → push atlanır, olaylar
# DB'ye yine yazılır). Production'da true + gerçek NVR bilgileri.
DAHUA_ALARM_ENABLED=false
# Yöntem: virtual_input (CGI alarm.cgi). onvif/dss_custom ileride.
DAHUA_ALARM_METHOD=virtual_input
# Zone'da dahua_channel belirtilmezse kullanılacak varsayılan NVR channel
DAHUA_ALARM_CHANNEL=1
DAHUA_TIMEOUT_S=10
DAHUA_MAX_RETRIES=3
# Pending alarm retry worker periyodu (saniye)
DAHUA_RETRY_INTERVAL_S=300

# === Disk & Snapshot retention (M7) ===
# Enterprise model: zaman-tabanlı budama (disk hiç dolmasın) + eşik alarmı (DMSS).
# Ham video FIFO'su YOK — kayıt Dahua NVR'da, ring-buffer'ı NVR kendi yönetir.
DISK_MONITOR_ENABLED=true
# Disk kullanımı + snapshot dizini örnekleme periyodu (saniye)
DISK_CHECK_INTERVAL_S=300
# Disk doluluk eşiği (%) — aşılınca bir kez DMSS alarm + Grafana kırmızı
DISK_WARN_THRESHOLD_PCT=85
# Histerezis: alarm ancak (eşik − margin) altına düşünce resetlenir (flapping önler)
DISK_RECOVER_MARGIN_PCT=5
# Bridge snapshot store retention (gün) — bu yaştan eski snapshot dosyaları silinir
SNAPSHOT_RETENTION_DAYS=90
# Snapshot budama periyodu (saniye) — disk check'ten bağımsız, daha seyrek
SNAPSHOT_PRUNE_INTERVAL_S=3600

# === Frigate servis down-detection (M7) ===
# `frigate/available` LWT dinlenir; Frigate çökerse Dahua/DMSS alarm (frigate_offline).
# Kamera offline ≠ Frigate offline boşluğunu kapatır. Alarm channel: DAHUA_ALARM_CHANNEL.
FRIGATE_MONITOR_ENABLED=true

# === LLM Bütçe (PoC: 10, Production: 25) ===
LLM_MONTHLY_BUDGET_USD=10

# === SMTP (M6.5 sonrası kullanılır) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ainvr@example.com
SMTP_PASSWORD=change-me-gmail-app-password
SMTP_FROM=AI NVR <ainvr@example.com>
SMTP_TO_DEFAULT=guvenlik@example.com

# === Viewer (M6.5 sonrası kullanılır) ===
PORTAL_URL=https://ainvr.example.com
VIEW_TOKEN_SECRET=change-me-32-char-random-string-please
VIEW_TOKEN_TTL_DAYS=7

# === Frigate RTSP password (kameralar için) ===
FRIGATE_RTSP_PASSWORD=change-me

# === Frigate config.yml mount mode ===
# Dev: 'rw' (Frigate UI Zone Editor değişikliklerini host dosyasına persist eder).
# Production: 'ro' (config sadece git üzerinden değiştirilir, UI'dan değil).
FRIGATE_CONFIG_MODE=rw

# === Grafana ===
GRAFANA_ADMIN_PASSWORD=change-me-admin

# === Log seviyesi ===
LOG_LEVEL=INFO
