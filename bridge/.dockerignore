# Build context: ./bridge/ (docker-compose.yml'deki 'build: context: ./bridge').
# Path'ler bridge/'in kendisine göre değerlendirilir — örn. 'tests/' = bridge/tests/.

# Test ve cache dosyaları image'a girmesin
tests/
__pycache__/
*.py[cod]
*$py.class
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Virtual env (host'taki)
.venv/
venv/

# Build artifacts
build/
dist/
*.egg-info/

# IDE
.idea/
.vscode/

# Test/coverage
.coverage
htmlcov/
coverage.xml

# Git (Dockerfile zaten clean checkout'tan build edilir)
.git/
.gitignore
